# Keep source diffs stable across Windows and Unix checkouts.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Bundled donation codes are compared by SHA-256 in tests; never normalize them.
/frontend/src/assets/donation-*.jpeg binary

# Third-party notice texts are reproduced verbatim (and hash-checked); never normalize them.
/native/edit-content-engine/notices/** -text
