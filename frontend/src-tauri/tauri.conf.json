{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dokuwu",
  "version": "1.11.0",
  "identifier": "com.pdfmanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Dokuwu — Professional PDF Toolkit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/edit-content-runtime/": "edit-content/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "copyright": "Copyright © 2026 Dokuwu",
    "category": "Utility",
    "shortDescription": "Professional PDF management toolkit",
    "longDescription": "Dokuwu is a professional desktop application for merging, splitting, compressing, converting, and editing PDF documents. Everything runs on your computer."
  }
}
