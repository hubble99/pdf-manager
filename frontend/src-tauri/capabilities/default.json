  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.paypal.com/qrcodes/p2pqrc/VFBT2J9WJA3EY" }
      ]
    }
  ]
}
